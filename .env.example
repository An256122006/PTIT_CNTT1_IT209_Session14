# ===== MySQL (docker-compose.yml) =====
MYSQL_DATABASE=employee_db
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=change_me_user
MYSQL_PASSWORD=change_me_password

# ===== Docker image cho service backend =====
# Local: restapi-session04:latest
# Khi dùng CI/CD Docker Hub: <dockerhub_username>/devops-exam-app:latest
DOCKER_IMAGE=restapi-session04:latest

# ===== Spring Boot (chạy local, ghi đè application.properties) =====
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/db_cntt3_api_ss4?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me_password

# ===== App config =====
SERVER_PORT=8080
PAGE_SIZE_PRODUCTS=3
